# Copy to .env and adjust. Docker Compose reads it automatically.

# Postgres (used by docker compose)
POSTGRES_USER=market_miner
POSTGRES_PASSWORD=market_miner
POSTGRES_DB=market_miner
# Host port for Postgres, so it doesn't clash with a local install on 5432
DB_PORT=5433

# App
APP_PORT=8080
SCRAPE_INTERVAL_SECS=300
SCRAPER_ENABLED=true
RUST_LOG=market_miner=info,tower_http=info

# Only needed when running the binary outside Docker (cargo run)
DATABASE_URL=postgres://market_miner:market_miner@localhost:5433/market_miner
BIND_ADDR=127.0.0.1:8080
# MSE_URL=https://mse.co.mw/market/mainboard
# STATIC_DIR=web/dist
